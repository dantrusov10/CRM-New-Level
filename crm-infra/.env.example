# Domain used by Caddy to request certificates. Leave blank to use IP only.
DOMAIN=

# PostgreSQL settings
POSTGRES_DB=crm
POSTGRES_USER=crm
POSTGRES_PASSWORD=supersecret
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis connection URL
REDIS_URL=redis://redis:6379/0

# Backup configuration for pgbackups
POSTGRES_HOSTNAME=db
BACKUP_DIR=/backups
BACKUP_KEEP_DAYS=14
BACKUP_KEEP_WEEKS=8
BACKUP_KEEP_MONTHS=6
BACKUP_SCHEDULE=@daily

# Placeholder token for GigaChat API
GIGACHAT_TOKEN=your_token_here

# Application settings
APP_NAME=Sales Intelligence Hub
